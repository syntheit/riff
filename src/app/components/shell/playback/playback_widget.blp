using Gtk 4.0;
using Adw 1;

template $PlaybackWidget : Box {
  orientation: vertical;

  Overlay seek_overlay {
    overflow: visible;

    [overlay]
    Scale seek_bar {
      show-fill-level: true;
      restrict-to-fill-level: false;
      fill-level: 0;
      digits: 0;
      draw-value: false;

      styles [
        "seek-bar",
      ]
    }

    child: Box {
      can-target: false;
      valign: start;

      Label track_position {
        label: "0∶00";
        halign: start;
        visible: false;
        hexpand: true;

        styles [
          "numeric",
          "seek-time-label",
        ]
      }

      Label track_duration {
        label: "0∶00";
        halign: end;
        visible: false;

        styles [
          "numeric",
          "seek-time-label",
        ]
      }
    };
  }

  Adw.BreakpointBin {
    width-request: 1;
    height-request: 1;
    margin-top: 4;

    Adw.Breakpoint {
      condition("max-width:764sp")

      setters {
        layout-stack.visible-child-name: "mobile";
        seek_overlay.visible: false;
      }
    }

    child: Stack layout-stack {
      vhomogeneous: false;
      hhomogeneous: false;

      StackPage {
        name: "desktop";
        child: Grid desktop-grid {
          halign: fill;
          hexpand: true;
          column-homogeneous: true;
          margin-top: 8;
          margin-bottom: 8;
          margin-start: 8;
          margin-end: 8;

          Box {
            hexpand: true;
            height-request: 68;

            layout {
              column-span: "1";
              column: "0";
              row: "0";
            }

            $PlaybackInfoWidget now_playing {
              receives-default: "1";
              halign: "start";
              valign: "center";
              has-frame: "0";
              visible: false;
            }
          }

          $PlaybackControlsWidget controls {
            halign: center;
            layout {
              column-span: "1";
              column: "1";
              row: "0";
            }
          }

          Stack volume-stack {
            hexpand: true;
            halign: end;

            layout {
              column-span: "1";
              column: "2";
              row: "0";
            }

            StackPage {
              name: 'slider';
              child: Box {
                width-request: 250;
                Image {
                  icon-name: 'multimedia-volume-control-symbolic';
                }

                Scale volume_slider {
                  hexpand: true;
                  show-fill-level: true;
                  restrict-to-fill-level: false;
                  value-pos: left;

                  styles [
                    'volume-slider'
                  ]

                  adjustment: Adjustment {
                    lower: 0.0;
                    value: 0.7;
                    upper: 1.0;
                    step-increment: 0.01;
                    page-increment: 0.05;
                  };
                }
              };
            }
          }
        };
      }

      StackPage {
        name: "mobile";
        child: Box mobile_bar {
          orientation: vertical;

          styles [
            "mini-player",
          ]

          Box {
            spacing: 10;
            margin-start: 12;
            margin-end: 6;
            margin-top: 4;
            margin-bottom: 4;

            Image mobile_art {
              pixel-size: 44;
              valign: center;
              vexpand: false;
              overflow: hidden;

              styles [
                "mini-player-art",
              ]
            }

            Box {
              orientation: vertical;
              valign: center;
              hexpand: true;

              Label mobile_title {
                ellipsize: end;
                xalign: 0;
                single-line-mode: true;

                styles [
                  "heading",
                ]
              }

              Label mobile_artist {
                ellipsize: end;
                xalign: 0;
                single-line-mode: true;

                styles [
                  "caption",
                  "dim-label",
                ]
              }
            }

            Button mobile_add {
              valign: center;
              focus-on-click: false;
              can-focus: false;
              tooltip-text: _("Add to playlist");

              styles [
                "circular",
                "add-to-playlist-btn",
              ]

              Image mobile_add_icon {
                icon-name: "list-add-symbolic";
                pixel-size: 14;
              }
            }

            Button mobile_play_pause {
              icon-name: "media-playback-start-symbolic";
              valign: center;
              focus-on-click: false;
              can-focus: false;

              styles [
                "flat",
                "circular",
              ]
            }
          }

          ProgressBar mini_progress {
            styles [
              "mini-progress",
            ]
          }
        };
      }
    };
  }
}
