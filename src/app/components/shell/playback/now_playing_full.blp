using Gtk 4.0;
using Adw 1;

template $NowPlayingFullWidget : Adw.Bin {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      // NOTE: do NOT set `show-title: false` here — Adw.HeaderBar hides its
      // custom [title] widget when show-title is false, which suppressed the
      // "PLAYING FROM <source>" header entirely. The header's own
      // `source_button.visible` (driven from NowPlayingSheet) controls when it
      // shows, so the title slot must remain enabled.
      show-title: true;

      Button close_button {
        icon-name: "go-down-symbolic";
        tooltip-text: _("Close");
        focus-on-click: false;
        can-focus: false;
      }

      // "PLAYING FROM <TYPE>" / "<name>" — the tappable source header (mirrors
      // Spotify). Hidden until there's a navigable source; tapping navigates to
      // that source and closes the sheet. Driven from NowPlayingSheet::on_event.
      [title]
      Button source_button {
        visible: false;
        focus-on-click: false;
        can-focus: false;

        styles [
          "flat",
        ]

        Box {
          orientation: vertical;
          valign: center;
          halign: center;

          Label source_type_label {
            ellipsize: end;
            xalign: 0.5;
            label: "";

            styles [
              "caption-heading",
              "dim-label",
            ]
          }

          Label source_name_label {
            ellipsize: end;
            xalign: 0.5;
            label: "";

            styles [
              "heading",
            ]
          }
        }
      }

      // Hidden by default; shown + wired only when FeatureFlag::DeviceSelector
      // is enabled (see App::make_device_selector).
      [end]
      $DeviceSelectorWidget device_selector {
        visible: false;
      }
    }

    // height-request forces the sheet to full window height (it's capped at the
    // window), so the player is fullscreen rather than a content-sized popup.
    content: Box {
      orientation: vertical;
      vexpand: true;
      height-request: 800;
      spacing: 12;
      margin-start: 24;
      margin-end: 24;
      margin-top: 8;
      margin-bottom: 28;

      // Art fills the upper flexible area, centred.
      Box {
        vexpand: true;
        valign: center;

        Picture art {
          content-fit: cover;
          width-request: 300;
          height-request: 300;
          halign: center;
          valign: center;
          hexpand: true;
          overflow: hidden;

          styles [
            "now-playing-art",
          ]
        }
      }

      Box {
        orientation: vertical;
        spacing: 2;

        Label title {
          ellipsize: end;
          xalign: 0;
          label: "";

          styles [
            "title-1",
          ]
        }

        Label artist {
          ellipsize: end;
          xalign: 0;
          label: "";

          styles [
            "title-4",
            "dim-label",
          ]
        }

        // "Playing on <device>" — shown only while a Connect device is active,
        // hidden when playing locally. Driven from NowPlayingSheet::on_event.
        Label playing_on_label {
          ellipsize: end;
          xalign: 0;
          label: "";
          visible: false;

          styles [
            "caption",
            "accent",
          ]
        }
      }

      Box {
        orientation: vertical;
        spacing: 2;

        Scale scrubber {
          hexpand: true;
          draw-value: false;

          adjustment: Adjustment {
            lower: 0;
            upper: 0;
            step-increment: 5000;
            page-increment: 10000;
          };
        }

        Box {
          Label position {
            label: "0∶00";
            xalign: 0;
            hexpand: true;

            styles [
              "numeric",
              "caption",
              "dim-label",
            ]
          }

          Label duration {
            label: "0∶00";
            xalign: 1;

            styles [
              "numeric",
              "caption",
              "dim-label",
            ]
          }
        }
      }

      $PlaybackControlsWidget controls {
        halign: center;
      }

      Box {
        halign: center;
        spacing: 16;

        Button add_to_playlist_button {
          styles [
            "circular",
            "add-to-playlist-btn",
          ]

          Image add_to_playlist_icon {
            icon-name: "list-add-symbolic";
            pixel-size: 20;
          }
        }

        Button queue_button {
          styles [
            "flat",
          ]

          Adw.ButtonContent {
            icon-name: "music-queue-symbolic";
            label: _("Queue");
          }
        }
      }
    };
  }
}
