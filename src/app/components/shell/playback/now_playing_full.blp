using Gtk 4.0;
using Adw 1;

template $NowPlayingFullWidget : Adw.Bin {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-title: true;

      [start]
      Button close_button {
        icon-name: "pan-down-symbolic";
        tooltip-text: _("Close player");
        focus-on-click: false;
        can-focus: false;
      }

      // The playback-source name. It is hidden only when no actual source name
      // is available and never repeats a generic type such as "ALBUM" above the
      // actual name. Remote-mirrored source names are intentionally not links.
      [title]
      Button source_button {
        visible: false;
        focus-on-click: false;
        can-focus: false;

        styles [
          "flat",
        ]

        Label source_name_label {
          ellipsize: end;
          xalign: 0.5;
          label: "";

          styles [
            "heading",
          ]
        }
      }

      // Keep the overflow menu in the upper-right corner. Device selection
      // belongs in the player footer, so this header has one explicit close
      // control on the left and one options control on the right.
      [end]
      Button menu_button {
        icon-name: "view-more-symbolic";
        tooltip-text: _("Options");
        focus-on-click: false;
        can-focus: false;
      }
    }

    // height-request forces the sheet to full window height (it's capped at the
    // window), so the player is fullscreen rather than a content-sized popup.
    content: Box {
      orientation: vertical;
      vexpand: true;
      height-request: 800;
      spacing: 12;
      margin-start: 24;
      margin-end: 24;
      margin-top: 8;
      margin-bottom: 28;

      // Art fills the upper flexible area, centred.
      Box {
        vexpand: true;
        valign: center;

        Picture art {
          content-fit: cover;
          width-request: 300;
          height-request: 300;
          halign: center;
          valign: center;
          hexpand: true;
          overflow: hidden;

          styles [
            "now-playing-art",
          ]
        }
      }

      Box {
        spacing: 12;

        Box {
          orientation: vertical;
          spacing: 0;
          hexpand: true;

          Button title_button {
            focus-on-click: false;
            can-focus: false;
            has-frame: false;

            styles [
              "flat",
              "now-playing-metadata-button",
            ]

            Label title {
              ellipsize: end;
              xalign: 0;
              label: "";

              styles [
                "title-2",
              ]
            }
          }

          Button artist_button {
            focus-on-click: false;
            can-focus: false;
            has-frame: false;

            styles [
              "flat",
              "now-playing-metadata-button",
            ]

            Label artist {
              ellipsize: end;
              xalign: 0;
              label: "";

              styles [
                "body",
                "dim-label",
              ]
            }
          }
        }

        Button add_to_playlist_button {
          halign: end;
          valign: center;

          styles [
            "circular",
            "add-to-playlist-btn",
          ]

          Image add_to_playlist_icon {
            icon-name: "list-add-symbolic";
            pixel-size: 20;
          }
        }
      }

      Box {
        orientation: vertical;
        spacing: 2;

        Scale scrubber {
          hexpand: true;
          draw-value: false;

          adjustment: Adjustment {
            lower: 0;
            upper: 0;
            step-increment: 5000;
            page-increment: 10000;
          };
        }

        Box {
          Label position {
            label: "0∶00";
            xalign: 0;
            hexpand: true;

            styles [
              "numeric",
              "caption",
              "dim-label",
            ]
          }

          Label duration {
            label: "0∶00";
            xalign: 1;

            styles [
              "numeric",
              "caption",
              "dim-label",
            ]
          }
        }
      }

      $NowPlayingControlsWidget controls {
        hexpand: true;
      }

      Box {
        hexpand: true;
        spacing: 12;

        // The visible device text is the sole entry point to the existing
        // picker/popover. It stays bottom-left; the flexible spacer keeps Queue
        // bottom-right without creating a non-clickable duplicate label.
        $DeviceSelectorWidget device_selector {
          halign: start;
          focus-on-click: false;
          can-focus: false;

          styles [
            "flat",
          ]
        }

        Box {
          hexpand: true;
        }

        Button queue_button {
          halign: end;
          valign: center;
          focus-on-click: false;
          icon-name: "music-queue-symbolic";

          styles [
            "flat",
          ]
        }
      }
    };
  }
}
