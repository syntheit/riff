using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  default-width: 1080;
  default-height: 720;

  Adw.BottomSheet now_playing_sheet {
    // Non-modal so the window's ShortcutController keeps working while the sheet
    // is open; the sheet covers the content anyway.
    modal: false;

    content: Box {
      orientation: vertical;

      ShortcutController {
        scope: local;

        Shortcut {
          trigger: "space";
          action: "action(app.toggle_playback)";
        }

        Shortcut {
          trigger: "<Ctrl>Q";
          action: "action(app.quit)";
        }

        Shortcut {
          trigger: "P";
          action: "action(app.player_prev)";
        }

        Shortcut {
          trigger: "N";
          action: "action(app.player_next)";
        }

        Shortcut {
          trigger: "<Alt>Left";
          action: "action(app.nav_pop)";
        }

        Shortcut {
          trigger: "<Ctrl>F";
          action: "action(app.search)";
        }
      }

      Adw.ToastOverlay main {
        hexpand: true;
        vexpand: true;

        // One navigation view for the whole app: the tab shell is its root page;
        // album/artist/playlist/user detail pages push on top (with swipe-back).
        Adw.NavigationView root_nav {
          Adw.NavigationPage {
            title: _("Riff");
            tag: "tabs";
            can-pop: false;

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                show-title: false;

                [end]
                MenuButton user {
                  icon-name: "open-menu-symbolic";
                  focus-on-click: false;
                  can-focus: false;
                }
              }

              // The three tabs. Pages are populated in Rust (Navigation) so the
              // existing screen components can be reused unchanged.
              content: Adw.ViewStack tab_stack {
                vexpand: true;
              };

              [bottom]
              Adw.ViewSwitcherBar tab_bar {
                stack: tab_stack;
                reveal: true;
              }
            };
          }
        }
      }
    };

    [bottom-bar]
    Overlay {
      hexpand: true;

      $PlaybackWidget playback {
        hexpand: "1";
      }

      [overlay]
      $SelectionToolbarWidget selection_toolbar {
        hexpand: "1";
      }
    }

    [sheet]
    $NowPlayingFullWidget now_playing_full {
    }
  }
}

Adw.AboutDialog about {
  application-name: "Riff";
  application-icon: "dev.diegovsky.Riff";
  website: "https://github.com/Diegovsky/riff";
  support-url: "https://discord.gg/rAAvFSC7VQ";
  issue-url: "https://github.com/Diegovsky/riff/issues";
  license-type: mit_x11;
}
