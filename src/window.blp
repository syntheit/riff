using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  default-width: 1080;
  default-height: 720;

  // Library long-press context drawer. Outermost sheet so it appears over
  // everything. Opened programmatically via ShowLibraryItemMenu (GtkGestureLongPress
  // on a library row/card).
  Adw.BottomSheet library_menu_sheet {
    modal: true;

    content: Adw.BottomSheet add_to_playlist_sheet {
    modal: true;

    content: Adw.BottomSheet song_menu_sheet {
    modal: true;

    content: Adw.BottomSheet queue_sheet {
    modal: true;

    content: Adw.BottomSheet now_playing_sheet {
    // Non-modal so the window's ShortcutController keeps working while the sheet
    // is open. Opened by tapping the mini-player; there is no collapsed bottom-bar
    // (the mini-player + tab bar live in the content so they're always visible).
    modal: false;

    content: Box {
      orientation: vertical;

      ShortcutController {
        scope: local;

        Shortcut {
          trigger: "space";
          action: "action(app.toggle_playback)";
        }

        Shortcut {
          trigger: "<Ctrl>Q";
          action: "action(app.quit)";
        }

        Shortcut {
          trigger: "P";
          action: "action(app.player_prev)";
        }

        Shortcut {
          trigger: "N";
          action: "action(app.player_next)";
        }

        Shortcut {
          trigger: "<Alt>Left";
          action: "action(app.nav_pop)";
        }

        Shortcut {
          trigger: "<Ctrl>F";
          action: "action(app.search)";
        }
      }

      // Tab shell + pushed detail pages.
      // Wrapped in an Overlay so the ⋯ menu button can float top-right
      // without any HeaderBar (which would create dead space under the
      // system top bar on GNOME Shell Mobile).
      Overlay {
        hexpand: true;
        vexpand: true;

        Adw.ToastOverlay main {
          hexpand: true;
          vexpand: true;

          Adw.NavigationView root_nav {
            Adw.NavigationPage {
              title: _("Riff");
              tag: "tabs";
              can-pop: false;

              child: Adw.ViewStack tab_stack {
                vexpand: true;
              };
            }
          }
        }

        // Menu button pinned top-right (Spotify-style). Hidden on pushed detail
        // pages by UserMenu's NavigationPushed/Popped handling.
        [overlay]
        MenuButton user {
          icon-name: "open-menu-symbolic";
          focus-on-click: false;
          can-focus: false;
          halign: end;
          valign: start;
          margin-top: 4;
          margin-end: 8;
        }
      }

      // Mini-player, above the tab bar (Spotify order).
      Overlay {
        hexpand: true;

        $PlaybackWidget playback {
          hexpand: "1";
        }

        [overlay]
        $SelectionToolbarWidget selection_toolbar {
          hexpand: "1";
        }
      }

      // Bottom tab bar (Home / Search / Library), always visible.
      Box {
        orientation: horizontal;

        Adw.ViewSwitcherBar tab_bar {
          stack: tab_stack;
          reveal: true;
          hexpand: true;
        }
      }
    };

    [sheet]
    $NowPlayingFullWidget now_playing_full {
    }
    };

    // The queue card. height-request keeps it partial (~65%) so the player
    // stays visible behind it; the list scrolls within. Device-tuned.
    [sheet]
    Box {
      orientation: vertical;
      height-request: 600;

      Adw.Bin queue_host {
        vexpand: true;
      }
    }
    };

    // Song context-menu drawer. Content-sized (short list of actions);
    // no fixed height-request — let the rows dictate the height.
    [sheet]
    Adw.Bin song_menu_host {
    }
    };

    // The add-to-playlist drawer. Hosted in a Bin so the component can swap
    // content when a different song is targeted. The wrapping Box sets a fixed
    // height (~75-80% of a typical phone screen) so the inner ScrolledWindow
    // has room to expand — mirrors the queue sheet pattern above. vexpand lets it
    // grow to whatever height the sheet is given (AdwBottomSheet caps it to the
    // window) so the inner ScrolledWindow always has bounded room and can scroll
    // the whole owned list to the bottom instead of running off-screen.
    [sheet]
    Box {
      orientation: vertical;
      vexpand: true;
      height-request: 700;

      Adw.Bin add_to_playlist_host {
        vexpand: true;
      }
    }
    };

    // The library context drawer. Content-sized (short list of actions); no fixed
    // height-request — let the rows dictate the height (mirrors song_menu_host).
    [sheet]
    Adw.Bin library_menu_host {
    }
  }
}

Adw.AboutDialog about {
  application-name: "Riff";
  application-icon: "dev.diegovsky.Riff";
  website: "https://github.com/Diegovsky/riff";
  support-url: "https://discord.gg/rAAvFSC7VQ";
  issue-url: "https://github.com/Diegovsky/riff/issues";
  license-type: mit_x11;
}
